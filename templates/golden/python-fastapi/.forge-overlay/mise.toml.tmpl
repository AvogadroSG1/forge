[tools]
python = "3.14.4"
ruff = "latest"
"npm:pyright" = "latest"
"pipx:pip-audit" = "latest"
lefthook = "latest"
"github:Dicklesworthstone/destructive_command_guard" = "latest"
{{- if .Frontend }}
node = "24"
{{- end }}

[tasks.fmt]
run = "ruff format ."

[tasks.lint]
run = "ruff check . && pyright"

[tasks.test]
run = "pytest -q --cov=."
{{- if .Frontend }}

[tasks.web-fmt]
run = "npm --prefix web run fmt"

[tasks.web-lint]
run = "npm --prefix web run lint && npm --prefix web run typecheck"

[tasks.web-test]
run = "npm --prefix web test"

[tasks.ci]
run = "mise run fmt && mise run lint && mise run test && pip-audit && mise run web-fmt && mise run web-lint && mise run web-test && npm --prefix web audit --audit-level=high"
{{- else }}

[tasks.ci]
run = "mise run fmt && mise run lint && mise run test && pip-audit"
{{- end }}
