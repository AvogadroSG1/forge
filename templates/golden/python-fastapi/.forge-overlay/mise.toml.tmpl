[tools]
python = "3.15.2"
uv = "0.13.9"
ruff = "0.17.5"
"npm:pyright" = "1.1.414"
hadolint = "2.15.1"
trivy = "0.76.2"
"pipx:pip-audit" = "2.10.1"
lefthook = "2.2.2"
"github:Dicklesworthstone/destructive_command_guard" = "0.16.0"
{{- if .Frontend }}
node = "26.13.1"
{{- end }}

[tasks.fmt]
run = "ruff format ."

[tasks.lint]
run = "ruff check . && uv run pyright"

[tasks.test]
run = "uv run pytest -q --cov=."

# opentelemetry-instrument reads OTEL_* from the environment; the endpoint guard keeps exporters off when no OTLP endpoint is set.
[tasks.serve]
run = "export OTEL_SERVICE_NAME=\"${OTEL_SERVICE_NAME:-{{.RepoSlug}}}\"; if [ -z \"${OTEL_EXPORTER_OTLP_ENDPOINT:-}${OTEL_EXPORTER_OTLP_TRACES_ENDPOINT:-}${OTEL_EXPORTER_OTLP_METRICS_ENDPOINT:-}\" ]; then export OTEL_TRACES_EXPORTER=none OTEL_METRICS_EXPORTER=none OTEL_LOGS_EXPORTER=none; else export OTEL_EXPORTER_OTLP_PROTOCOL=${OTEL_EXPORTER_OTLP_PROTOCOL:-http/protobuf}; fi; uv run opentelemetry-instrument app"
# Container image gates (see CONTAINER.md). image:lint needs no Docker and is
# part of ci; image and image:scan need a running Docker daemon and are run on
# demand and as their own CI step. Bodies stay POSIX sh.
[tasks."image:lint"]
description = "Lint the Dockerfile"
run = "hadolint Dockerfile"

[tasks.image]
description = "Build the runtime and sandbox images; IMAGE names them, PLATFORM cross-builds"
run = '''
set -eu
image="${IMAGE:-app}"
revision="$(git rev-parse HEAD 2>/dev/null || echo unknown)"
for target in runtime sandbox; do
  docker build ${PLATFORM:+--platform "$PLATFORM"} \
    --target "$target" \
    --build-arg "REVISION=$revision" \
    --tag "$image:$target" .
done
'''

[tasks."image:scan"]
description = "Scan the runtime image for fixable HIGH and CRITICAL vulnerabilities"
depends = ["image"]
run = 'trivy image --exit-code 1 --severity HIGH,CRITICAL --ignore-unfixed "${IMAGE:-app}:runtime"'
{{- if .Frontend }}

[tasks.web-fmt]
run = "npm --prefix web run fmt"

[tasks.web-lint]
run = "npm --prefix web run lint && npm --prefix web run typecheck"

[tasks.web-test]
run = "npm --prefix web test"
{{- if eq .Frontend "angular" }}

# OTLP define bridge: browsers cannot read OTEL_* env vars, so web-dev/web-build
# inline the endpoint mise sets (.config/mise/conf.d/otel.toml, overridable in
# mise.local.toml) as FORGE_OTLP_ENDPOINT via `ng --define`; see
# web/src/environments/environment.ts. esbuild parses the define value as a JS
# literal, so the guard refuses characters that would need escaping. The
# control-character set is spelled out byte by byte (0x01-0x1f, 0x7f) because
# [[:cntrl:]] varies by locale. Bodies are POSIX sh (dash on Debian/Ubuntu); the
# task-level `shell = "sh -c"` pins that even when mise's inline shell is zsh.
# This block is byte-identical across the backend overlays (see
# TestOtelAngularBackendTaskBlocksIdentical).
[tasks.web-dev]
description = "Serve web/; inlines OTEL_EXPORTER_OTLP_ENDPOINT for the browser OTel exporter"
shell = "sh -c"
run = '''
set -eu
endpoint="${OTEL_EXPORTER_OTLP_ENDPOINT:-}"
ctrl="$(printf '\001\002\003\004\005\006\007\010\011\012\013\014\015\016\017\020\021\022\023\024\025\026\027\030\031\032\033\034\035\036\037\177')"
case "$endpoint" in
  *[\"\\]* | *[$ctrl]*)
    echo "web-dev: OTEL_EXPORTER_OTLP_ENDPOINT must not contain quotes, backslashes or control characters" >&2
    exit 1
    ;;
esac
exec npm --prefix web run start -- --define "FORGE_OTLP_ENDPOINT=\"$endpoint\""
'''

[tasks.web-build]
description = "Build web/; inlines OTEL_EXPORTER_OTLP_ENDPOINT for the browser OTel exporter"
shell = "sh -c"
run = '''
set -eu
endpoint="${OTEL_EXPORTER_OTLP_ENDPOINT:-}"
ctrl="$(printf '\001\002\003\004\005\006\007\010\011\012\013\014\015\016\017\020\021\022\023\024\025\026\027\030\031\032\033\034\035\036\037\177')"
case "$endpoint" in
  *[\"\\]* | *[$ctrl]*)
    echo "web-build: OTEL_EXPORTER_OTLP_ENDPOINT must not contain quotes, backslashes or control characters" >&2
    exit 1
    ;;
esac
exec npm --prefix web run build -- --define "FORGE_OTLP_ENDPOINT=\"$endpoint\""
'''
{{- end }}

[tasks.ci]
run = "uv sync --locked && mise run fmt && mise run lint && mise run image:lint && mise run test && uv export --locked --no-emit-project --format requirements-txt | pip-audit --disable-pip --require-hashes -r /dev/stdin && mise run web-fmt && mise run web-lint && mise run web-test && npm --prefix web audit --audit-level=high"
{{- else }}

[tasks.ci]
run = "uv sync --locked && mise run fmt && mise run lint && mise run image:lint && mise run test && uv export --locked --no-emit-project --format requirements-txt | pip-audit --disable-pip --require-hashes -r /dev/stdin"
{{- end }}
