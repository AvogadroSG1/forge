namespace Microsoft.Extensions.DependencyInjection
{
    using OpenTelemetry;
    using OpenTelemetry.Metrics;
    using OpenTelemetry.Resources;
    using OpenTelemetry.Trace;

    /// <summary>
    /// Registers the default OpenTelemetry tracing and metrics pipeline for the application.
    /// </summary>
    public static class TelemetryServiceCollectionExtensions
    {
        /// <summary>
        /// Adds tracer and meter providers that export over OTLP only when <c>OTEL_EXPORTER_OTLP_ENDPOINT</c> is set.
        /// </summary>
        /// <param name="services">The service collection to configure.</param>
        /// <param name="configureTracing">Optional additional tracing configuration, such as a test exporter.</param>
        /// <param name="configureMetrics">Optional additional metrics configuration, such as a test exporter.</param>
        /// <returns>The same service collection so calls can be chained.</returns>
        public static IServiceCollection AddDefaultOpenTelemetry(
            this IServiceCollection services,
            Action<TracerProviderBuilder>? configureTracing = null,
            Action<MeterProviderBuilder>? configureMetrics = null)
        {
            var exportOverOtlp = global::Telemetry.OtlpExporterConfigured;
            var openTelemetry = services.AddOpenTelemetry();

            openTelemetry.ConfigureResource(resource => resource.AddService(global::Telemetry.ServiceName));

            openTelemetry.WithTracing(tracing =>
            {
                tracing.AddSource(global::Telemetry.Source.Name);

                if (exportOverOtlp)
                {
                    tracing.AddOtlpExporter();
                }

                configureTracing?.Invoke(tracing);
            });

            openTelemetry.WithMetrics(metrics =>
            {
                metrics.AddMeter(global::Telemetry.Meter.Name);
                metrics.AddRuntimeInstrumentation();

                if (exportOverOtlp)
                {
                    metrics.AddOtlpExporter();
                }

                configureMetrics?.Invoke(metrics);
            });

            return services;
        }
    }
}
