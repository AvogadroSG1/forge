    "@opentelemetry/instrumentation": "0.223.2",
    "@opentelemetry/instrumentation-fetch": "0.223.2",
    "@opentelemetry/resources": "2.12.1",
    "@opentelemetry/sdk-metrics": "2.12.1",
    "@opentelemetry/sdk-trace-web": "2.12.1",
    "@opentelemetry/semantic-conventions": "1.45.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "^4.1.10"
