[build-system]
requires = ["hatchling==1.33.0"]
build-backend = "hatchling.build"

[project]
name = "{{.PythonPackage}}"
version = "0.1.0"
description = "Walking-skeleton Typer CLI"
readme = "README.md"
requires-python = ">=3.12"
dependencies = [
  "opentelemetry-distro==0.66b2",
  "opentelemetry-exporter-otlp-proto-http==1.45.2",
  "typer==0.29.1",
]

[project.optional-dependencies]
dev = [
  "pytest==9.2.0",
  "pytest-cov==7.1.0",
  "pytest-mock==3.17.0",
]

[tool.hatch.build.targets.wheel]
packages = ["src/{{.PythonPackage}}"]

[project.scripts]
{{.PythonPackage}} = "{{.PythonPackage}}.main:main"

[tool.coverage.run]
patch = ["subprocess"]
