// Package telemetry bootstraps OpenTelemetry tracing and metrics for the
// service. Providers are always installed so instrumentation is cheap to add
// anywhere; OTLP/HTTP exporters are only attached when the standard
// OTEL_EXPORTER_OTLP_* environment variables name a collector, so a repo with
// no collector running produces no network traffic and no exporter noise.
package telemetry

import (
	"context"
	"errors"
	"os"

	"go.opentelemetry.io/contrib/instrumentation/runtime"
	"go.opentelemetry.io/otel"
	"go.opentelemetry.io/otel/exporters/otlp/otlpmetric/otlpmetrichttp"
	"go.opentelemetry.io/otel/exporters/otlp/otlptrace/otlptracehttp"
	"go.opentelemetry.io/otel/metric"
	"go.opentelemetry.io/otel/propagation"
	sdkmetric "go.opentelemetry.io/otel/sdk/metric"
	"go.opentelemetry.io/otel/sdk/resource"
	sdktrace "go.opentelemetry.io/otel/sdk/trace"
	semconv "go.opentelemetry.io/otel/semconv/v1.43.0"
	"go.opentelemetry.io/otel/trace"
)

// instrumentationName scopes the tracer and meter returned by Tracer and Meter.
const instrumentationName = "{{.ModulePath}}"

// defaultServiceName is used when neither Options.ServiceName nor
// OTEL_SERVICE_NAME is set.
const defaultServiceName = "{{.RepoSlug}}"

// Options tunes Setup. The zero value is production-ready: exporters are
// selected from the environment. Tests inject SpanExporter and MetricReader to
// observe telemetry in memory without touching the network.
type Options struct {
	// ServiceName overrides OTEL_SERVICE_NAME and the built-in default.
	ServiceName string
	// SpanExporter, when set, replaces the env-gated OTLP trace exporter and
	// is wired synchronously so a test can read spans as soon as they end.
	SpanExporter sdktrace.SpanExporter
	// MetricReader, when set, replaces the env-gated OTLP metric reader.
	MetricReader sdkmetric.Reader
}

// Setup installs the global tracer provider, meter provider, and W3C
// propagators, then starts Go runtime metrics collection. The returned
// shutdown function flushes and stops both providers; callers should invoke it
// on exit and must not discard its error silently under errcheck, so prefer
// `defer func() { _ = shutdown(ctx) }()` or log the error.
func Setup(ctx context.Context, opts Options) (shutdown func(context.Context) error, err error) {
	res, err := newResource(opts.ServiceName)
	if err != nil {
		return nil, err
	}

	traceOpts, err := traceProviderOptions(ctx, res, opts)
	if err != nil {
		return nil, err
	}
	tracerProvider := sdktrace.NewTracerProvider(traceOpts...)

	reader, err := metricReader(ctx, opts)
	if err != nil {
		return nil, errors.Join(err, tracerProvider.Shutdown(ctx))
	}
	meterProvider := sdkmetric.NewMeterProvider(meterProviderOptions(res, reader)...)

	shutdown = func(ctx context.Context) error {
		return errors.Join(tracerProvider.Shutdown(ctx), meterProvider.Shutdown(ctx))
	}

	otel.SetTracerProvider(tracerProvider)
	otel.SetMeterProvider(meterProvider)
	otel.SetTextMapPropagator(propagation.NewCompositeTextMapPropagator(
		propagation.TraceContext{},
		propagation.Baggage{},
	))

	if err := runtime.Start(runtime.WithMeterProvider(meterProvider)); err != nil {
		return nil, errors.Join(err, shutdown(ctx))
	}

	return shutdown, nil
}

func traceProviderOptions(ctx context.Context, res *resource.Resource, opts Options) ([]sdktrace.TracerProviderOption, error) {
	traceOpts := []sdktrace.TracerProviderOption{sdktrace.WithResource(res)}
	switch {
	case opts.SpanExporter != nil:
		return append(traceOpts, sdktrace.WithSyncer(opts.SpanExporter)), nil
	case otlpConfigured("OTEL_EXPORTER_OTLP_TRACES_ENDPOINT"):
		spanExporter, exporterErr := otlptracehttp.New(ctx)
		if exporterErr != nil {
			return nil, exporterErr
		}
		return append(traceOpts, sdktrace.WithBatcher(spanExporter)), nil
	default:
		return traceOpts, nil
	}
}

func metricReader(ctx context.Context, opts Options) (sdkmetric.Reader, error) {
	if opts.MetricReader != nil {
		return opts.MetricReader, nil
	}
	if !otlpConfigured("OTEL_EXPORTER_OTLP_METRICS_ENDPOINT") {
		return nil, nil
	}
	metricExporter, exporterErr := otlpmetrichttp.New(ctx)
	if exporterErr != nil {
		return nil, exporterErr
	}
	return sdkmetric.NewPeriodicReader(metricExporter), nil
}

func meterProviderOptions(res *resource.Resource, reader sdkmetric.Reader) []sdkmetric.Option {
	metricOpts := []sdkmetric.Option{sdkmetric.WithResource(res)}
	if reader != nil {
		metricOpts = append(metricOpts, sdkmetric.WithReader(reader))
	}
	return metricOpts
}

// Tracer returns the tracer for this module from the global provider.
func Tracer() trace.Tracer {
	return otel.Tracer(instrumentationName)
}

// Meter returns the meter for this module from the global provider.
func Meter() metric.Meter {
	return otel.Meter(instrumentationName)
}

// newResource merges the SDK defaults (which already honour OTEL_SERVICE_NAME)
// with an explicit service.name so a generated repo never reports
// "unknown_service". The service.name resource is schemaless on purpose:
// resource.Merge fails with ErrSchemaURLConflict when both sides carry
// different schema URLs, and pinning semconv.SchemaURL here would break as soon
// as the SDK's default resource moved to a newer semconv release.
func newResource(serviceName string) (*resource.Resource, error) {
	if serviceName == "" {
		serviceName = os.Getenv("OTEL_SERVICE_NAME")
	}
	if serviceName == "" {
		serviceName = defaultServiceName
	}
	return resource.Merge(
		resource.Default(),
		resource.NewSchemaless(semconv.ServiceName(serviceName)),
	)
}

// otlpConfigured reports whether a collector endpoint has been provided for
// the given signal, either through the shared endpoint or the per-signal one.
func otlpConfigured(signalEndpointEnv string) bool {
	return os.Getenv("OTEL_EXPORTER_OTLP_ENDPOINT") != "" || os.Getenv(signalEndpointEnv) != ""
}
