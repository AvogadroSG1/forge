"""OpenTelemetry bootstrap: traces and metrics with env-gated OTLP/HTTP export.

Tracer and meter providers are always installed so instrumentation has
somewhere to report. OTLP exporters are attached only when
``OTEL_EXPORTER_OTLP_ENDPOINT`` (or a per-signal
``OTEL_EXPORTER_OTLP_<SIGNAL>_ENDPOINT``) is set, so a repo with no collector
running stays silent. When the process is started through
``opentelemetry-instrument`` the wrapper has already installed SDK providers and
:func:`configure` reuses them instead of competing with them.
"""

from __future__ import annotations

import os

from opentelemetry import metrics, trace
from opentelemetry.exporter.otlp.proto.http.metric_exporter import (
    OTLPMetricExporter,
)
from opentelemetry.exporter.otlp.proto.http.trace_exporter import OTLPSpanExporter
from opentelemetry.metrics import Meter
from opentelemetry.sdk.metrics import MeterProvider
from opentelemetry.sdk.metrics.export import (
    MetricReader,
    PeriodicExportingMetricReader,
)
from opentelemetry.sdk.resources import Resource
from opentelemetry.sdk.trace import TracerProvider
from opentelemetry.sdk.trace.export import (
    BatchSpanProcessor,
    SimpleSpanProcessor,
    SpanExporter,
)
from opentelemetry.trace import Tracer

DEFAULT_SERVICE_NAME = "{{.RepoSlug}}"

_GENERIC_ENDPOINT_ENV = "OTEL_EXPORTER_OTLP_ENDPOINT"


def service_name_from_env(default: str = DEFAULT_SERVICE_NAME) -> str:
    """Return ``OTEL_SERVICE_NAME`` when set, otherwise ``default``."""
    return os.environ.get("OTEL_SERVICE_NAME") or default


def otlp_endpoint_configured(signal: str) -> bool:
    """Report whether an OTLP endpoint is configured for ``signal``.

    ``signal`` is ``"TRACES"`` or ``"METRICS"``; the generic endpoint variable
    covers every signal.
    """
    per_signal_env = "OTEL_EXPORTER_OTLP_" + signal + "_ENDPOINT"
    return bool(os.environ.get(_GENERIC_ENDPOINT_ENV) or os.environ.get(per_signal_env))


def build_providers(
    service_name: str,
    *,
    span_exporter: SpanExporter | None = None,
    metric_reader: MetricReader | None = None,
) -> tuple[TracerProvider, MeterProvider]:
    """Build tracer and meter providers without touching global state.

    Injected ``span_exporter`` / ``metric_reader`` take precedence (tests use
    in-memory ones). Otherwise OTLP/HTTP exporters are attached only when the
    matching endpoint environment variable is set.
    """
    resource = Resource.create({"service.name": service_name})

    tracer_provider = TracerProvider(resource=resource)
    if span_exporter is not None:
        tracer_provider.add_span_processor(SimpleSpanProcessor(span_exporter))
    elif otlp_endpoint_configured("TRACES"):
        tracer_provider.add_span_processor(BatchSpanProcessor(OTLPSpanExporter()))

    readers: list[MetricReader] = []
    if metric_reader is not None:
        readers.append(metric_reader)
    elif otlp_endpoint_configured("METRICS"):
        readers.append(PeriodicExportingMetricReader(OTLPMetricExporter()))
    meter_provider = MeterProvider(resource=resource, metric_readers=readers)

    return tracer_provider, meter_provider


def configure(service_name: str = DEFAULT_SERVICE_NAME) -> TracerProvider:
    """Install global providers once and return the live SDK tracer provider.

    If an SDK tracer provider is already registered (for example by
    ``opentelemetry-instrument``), it is returned unchanged so callers can attach
    processors to whatever provider is actually in use.
    """
    current = trace.get_tracer_provider()
    if isinstance(current, TracerProvider):
        return current

    tracer_provider, meter_provider = build_providers(
        service_name_from_env(service_name)
    )
    trace.set_tracer_provider(tracer_provider)
    metrics.set_meter_provider(meter_provider)
    return tracer_provider


def get_tracer(name: str = __name__) -> Tracer:
    """Return a tracer from the global provider."""
    return trace.get_tracer(name)


def get_meter(name: str = __name__) -> Meter:
    """Return a meter from the global provider."""
    return metrics.get_meter(name)
