using System.Collections.Generic;
using System.Diagnostics;
using Microsoft.Extensions.DependencyInjection;
using OpenTelemetry.Metrics;
using OpenTelemetry.Trace;
using Xunit;

/// <summary>
/// Verifies the default OpenTelemetry bootstrap produces spans and metrics.
/// </summary>
public sealed class TelemetryTests
{
    /// <summary>
    /// Ensures activities started from the application source reach the configured exporter.
    /// </summary>
    [Fact]
    public void DefaultOpenTelemetryExportsActivities()
    {
        var exported = new List<Activity>();
        var services = new ServiceCollection().AddDefaultOpenTelemetry(tracing => tracing.AddInMemoryExporter(exported));
        using var provider = services.BuildServiceProvider();
        var tracerProvider = provider.GetRequiredService<TracerProvider>();

        using (var activity = Telemetry.Source.StartActivity("unit"))
        {
            Assert.NotNull(activity);
        }

        Assert.True(tracerProvider.ForceFlush());
        Assert.Contains(exported, exportedActivity => exportedActivity.DisplayName == "unit");
    }

    /// <summary>
    /// Ensures measurements recorded on the application meter reach the configured exporter.
    /// </summary>
    [Fact]
    public void DefaultOpenTelemetryExportsMetrics()
    {
        var exported = new List<Metric>();
        var services = new ServiceCollection().AddDefaultOpenTelemetry(configureMetrics: metrics => metrics.AddInMemoryExporter(exported));
        using var provider = services.BuildServiceProvider();
        var meterProvider = provider.GetRequiredService<MeterProvider>();

        var counter = Telemetry.Meter.CreateCounter<long>("unit.counter");
        counter.Add(1);

        Assert.True(meterProvider.ForceFlush());
        Assert.Contains(exported, exportedMetric => exportedMetric.Name == "unit.counter");
    }
}
