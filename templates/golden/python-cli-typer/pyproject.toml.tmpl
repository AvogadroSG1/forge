[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{.PythonPackage}}"
version = "0.1.0"
description = "Walking-skeleton Typer CLI"
readme = "README.md"
requires-python = ">=3.12"
dependencies = [
  "opentelemetry-distro~=0.65b0",
  "opentelemetry-exporter-otlp-proto-http~=1.44",
  "typer>=0.12,<1.0",
]

[project.optional-dependencies]
dev = [
  "pytest>=8.2,<9.0",
  "pytest-cov>=5.0,<6.0",
  "pytest-mock>=3.14,<4.0",
]

[tool.hatch.build.targets.wheel]
packages = ["src/{{.PythonPackage}}"]

[project.scripts]
{{.PythonPackage}} = "{{.PythonPackage}}.main:main"
