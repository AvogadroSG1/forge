{
	"name": "{{.NpmPackage}}",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"fmt": "prettier --write .",
		"fmt:check": "prettier --check .",
		"lint": "eslint .",
		"typecheck": "npm run check",
		"test": "vitest run"
	},
	"dependencies": {
		"@opentelemetry/api": "^1.10.0",
		"@opentelemetry/core": "^3.0.0",
		"@opentelemetry/exporter-metrics-otlp-http": "^0.300.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
		"@opentelemetry/instrumentation": "^0.300.0",
		"@opentelemetry/instrumentation-fetch": "^0.300.0",
		"@opentelemetry/resources": "^3.0.0",
		"@opentelemetry/sdk-metrics": "^3.0.0",
		"@opentelemetry/sdk-trace": "^3.0.0",
		"@opentelemetry/semantic-conventions": "^1.44.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"eslint": "^10.14.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
