[tools]
python = "3.14.4"
ruff = "latest"
"npm:pyright" = "latest"
"pipx:pip-audit" = "latest"
lefthook = "latest"
"github:Dicklesworthstone/destructive_command_guard" = "latest"

[tasks.fmt]
run = "ruff format ."

[tasks.lint]
run = "ruff check . && pyright"

[tasks.test]
run = "pytest -q --cov=."

# opentelemetry-instrument reads OTEL_* from the environment; the endpoint guard keeps exporters off when no OTLP endpoint is set.
[tasks.run-cli]
run = "export OTEL_SERVICE_NAME=\"${OTEL_SERVICE_NAME:-{{.RepoSlug}}}\"; if [ -z \"${OTEL_EXPORTER_OTLP_ENDPOINT:-}\" ]; then export OTEL_TRACES_EXPORTER=none OTEL_METRICS_EXPORTER=none OTEL_LOGS_EXPORTER=none; else export OTEL_EXPORTER_OTLP_PROTOCOL=${OTEL_EXPORTER_OTLP_PROTOCOL:-http/protobuf}; fi; opentelemetry-instrument {{.PythonPackage}}"

[tasks.ci]
run = "mise run fmt && mise run lint && mise run test && pip-audit"
