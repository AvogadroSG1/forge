# Allowlist: nothing enters the build context unless it is re-included here.
# This keeps secrets, VCS data and local state out of every image layer.
*

!go.mod
!go.sum
!**/*.go

# Tests are not needed to build the binary.
**/*_test.go

# Hidden directories and apm_modules/ hold agent tooling whose example sources
# match the re-includes above; they are not part of this module. BuildKit lets
# a file-level re-include beat a bare directory rule, so these end in /**.
.*/**
apm_modules/**
