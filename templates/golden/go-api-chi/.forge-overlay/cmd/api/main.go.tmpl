package main

import (
	"context"
	"errors"
	"log/slog"
	"net/http"
	"os"
	"os/signal"
	"syscall"
	"time"

	"{{.ModulePath}}/internal/httpapi"
	"{{.ModulePath}}/internal/telemetry"
)

// shutdownTimeout bounds both the HTTP drain and the telemetry flush so a
// stuck exporter cannot keep the process alive after SIGTERM.
const shutdownTimeout = 10 * time.Second

func main() {
	// Logs are an event stream: one JSON object per line on stdout, left for
	// the execution environment to collect and route.
	logger := slog.New(slog.NewJSONHandler(os.Stdout, nil))

	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	shutdown, err := telemetry.Setup(ctx, telemetry.Options{})
	if err != nil {
		logger.Error("telemetry setup", "error", err)
		os.Exit(1)
	}

	srv := &http.Server{
		Addr:              listenAddr(),
		Handler:           httpapi.NewRouter(logger),
		ReadHeaderTimeout: 10 * time.Second,
	}

	// A listen failure is delivered here rather than through an immediate exit so
	// telemetry still gets flushed before the process exits non-zero.
	listenErr := make(chan error, 1)
	go func() {
		logger.Info("listening", "addr", srv.Addr)
		if err := srv.ListenAndServe(); err != nil && !errors.Is(err, http.ErrServerClosed) {
			listenErr <- err
		}
	}()

	var exitErr error
	select {
	case <-ctx.Done():
		stop()
		shutdownCtx, cancel := context.WithTimeout(context.Background(), shutdownTimeout)
		if err := srv.Shutdown(shutdownCtx); err != nil {
			logger.Error("http shutdown", "error", err)
		}
		cancel()
	case exitErr = <-listenErr:
	}

	shutdownCtx, cancel := context.WithTimeout(context.Background(), shutdownTimeout)
	defer cancel()
	if err := shutdown(shutdownCtx); err != nil {
		logger.Error("telemetry shutdown", "error", err)
	}

	if exitErr != nil {
		logger.Error("listen", "error", exitErr)
		os.Exit(1)
	}
}

// defaultPort is used when PORT is unset, which is the local-development case.
const defaultPort = "8080"

// listenAddr takes the port from the PORT environment variable so the same
// build runs unchanged wherever it is deployed.
func listenAddr() string {
	port := os.Getenv("PORT")
	if port == "" {
		port = defaultPort
	}
	return ":" + port
}
