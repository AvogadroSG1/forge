{
	"name": "{{.NpmPackage}}",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"fmt": "prettier --write .",
		"fmt:check": "prettier --check .",
		"lint": "eslint .",
		"typecheck": "npm run check",
		"test": "vitest run"
	},
	"dependencies": {
		"@opentelemetry/api": "1.9.1",
		"@opentelemetry/exporter-metrics-otlp-http": "0.223.2",
		"@opentelemetry/exporter-trace-otlp-http": "0.223.2",
		"@opentelemetry/instrumentation": "0.223.2",
		"@opentelemetry/instrumentation-fetch": "0.223.2",
		"@opentelemetry/resources": "2.12.1",
		"@opentelemetry/sdk-metrics": "2.12.1",
		"@opentelemetry/sdk-trace-web": "2.12.1",
		"@opentelemetry/semantic-conventions": "1.45.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.0",
		"@sveltejs/adapter-auto": "7.0.1",
		"@sveltejs/kit": "2.70.4",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"eslint": "^9.39.0",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"prettier": "3.10.1",
		"prettier-plugin-svelte": "4.2.0",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"typescript": "6.0.3",
		"typescript-eslint": "8.73.0",
		"vite": "8.3.8",
		"vitest": "^4.1.10"
	}
}
